QWidget { font-family: "DejaVu Sans"; font-size: 12px; color: #233348; }
QMainWindow, QDialog, QMessageBox { background: #f3f6fa; }
QWidget#header, QWidget#sidebar { background: #ffffff; border: 1px solid #dce4ed; border-radius: 12px; }
QLabel { background: transparent; border: none; }
QLabel#workspaceTitle { font-size: 23px; font-weight: 600; color: #172b40; }
QLabel#subtitle, QLabel#canvasHint { color: #61758a; }
QLabel#sectionTitle { color: #5d7186; font-size: 10px; font-weight: bold; margin-top: 8px; }
QLabel#badge { background: #e4f3ef; color: #0f766e; padding: 7px 12px; border-radius: 10px; font-weight: bold; }
QLineEdit, QComboBox, QDoubleSpinBox, QListWidget {
    background: #f8fafc; border: 1px solid #d9e2ec; border-radius: 6px;
    padding: 7px; selection-background-color: #d5eee9; selection-color: #115e59;
}
QLineEdit:focus, QComboBox:focus, QDoubleSpinBox:focus, QListWidget:focus { border: 1px solid #0f9488; }
QComboBox::drop-down { border: none; width: 24px; }
QComboBox QAbstractItemView { background: white; color: #233348; selection-background-color: #d5eee9; }
QPushButton { background: #eef3f8; border: 1px solid #d5e0eb; border-radius: 6px; padding: 8px 12px; font-weight: 600; }
QPushButton:hover { background: #e0eaf3; border-color: #a7bacd; }
QPushButton:pressed { background: #cfdfeb; }
QPushButton:focus { border: 1px solid #0f9488; }
QPushButton#primaryButton { background: #0f766e; border-color: #0f766e; color: white; }
QPushButton#primaryButton:hover { background: #0d8b7f; }
QPushButton#primaryButton:pressed { background: #115e59; }
QPushButton#importButton { color: #0f766e; }
QPushButton:disabled { color: #94a3b8; background: #f1f5f9; }
QListWidget::item { padding: 4px; border-radius: 3px; }
QListWidget::item:selected { background: #d5eee9; color: #115e59; }
QGraphicsView { background: #f3f7fb; border: 1px solid #dce4ed; border-radius: 10px; }
QStatusBar { color: #61758a; background: #f3f6fa; }
QStatusBar::item { border: none; }
QMenu { background: white; border: 1px solid #dce4ed; padding: 4px; }
QMenu::item { padding: 7px 20px; }
QMenu::item:selected { background: #d5eee9; }
QToolTip { background: #172b40; color: white; padding: 6px; border: none; }
